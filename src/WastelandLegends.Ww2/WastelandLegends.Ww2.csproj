<Project Sdk="Microsoft.NET.Sdk">
  <!-- Wasteland Legends' bridge to Wild Wasteland 2: the only DLL compiled against WildWasteland.dll (Bridge.cs).
       Built next to WastelandLegends.dll and shipped with it. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>WastelandLegends.Ww2</AssemblyName>
    <RootNamespace>WastelandLegends.Ww2</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The game folder: three up when this sits in GameInternals\tools, else Steam's default (or pass -p:GameDir=...). -->
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\..\Apocalypter_Data')">$(MSBuildThisFileDirectory)..\..\..</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Apocalypter</GameDir>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\WastelandLegends\</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Where WW2 is when Apocasetter has it switched off. -->
    <Ww2Dll>$(GameDir)\BepInEx\plugins\WildWasteland2\WildWasteland.dll</Ww2Dll>
    <Ww2Dll Condition="!Exists('$(Ww2Dll)')">$(GameDir)\BepInEx\cache\Apocasetter\disabled\com.denis.apocalypter.wildwasteland2\plugins\WildWasteland2\WildWasteland.dll</Ww2Dll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(GameDir)\Apocalypter_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\Apocalypter_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WildWasteland"><HintPath>$(Ww2Dll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
